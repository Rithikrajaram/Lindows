{
  "manifest_version": 3,
  "name": "DualSync - Linux & Windows Auto Sync",
  "version": "1.0.0",
  "description": "Seamlessly sync downloaded files between Linux and Windows partitions in dual-boot setups.",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "storage",
    "notifications"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "DualSync Settings"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}